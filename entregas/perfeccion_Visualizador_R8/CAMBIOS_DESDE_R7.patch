+import sys
+from pathlib import Path
+sys.path.insert(0,str(Path(__file__).parent/'motor_superficies'))
+import numpy as np
+from OCP.Geom import Geom_BSplineSurface
+from OCP.TColgp import TColgp_Array2OfPnt
