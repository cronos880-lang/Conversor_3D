+def cargar(path):
+    m=trimesh.load(str(path),force='mesh',process=False)
+    vertices,inverse=np.unique(m.vertices,axis=0,return_inverse=True)
+    return trimesh.Trimesh(vertices,inverse[m.faces],process=False)
