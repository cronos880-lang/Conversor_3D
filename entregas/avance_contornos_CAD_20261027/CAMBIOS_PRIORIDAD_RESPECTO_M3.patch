+def _cilindro_segmentado(sections=128):
+    import trimesh
+    mesh=trimesh.creation.cylinder(radius=1.,height=2.,sections=sections)
+    ids=np.flatnonzero(abs(mesh.face_normals[:,2])<.1)
+    primitive={'type':'cylinder','point':np.zeros(3),'axis':np.array([0.,0.,1.]),'radius':1.,'faces':ids}
+    return mesh,primitive
+
+def test_cilindro_confirmado_no_es_absorbido_por_una_region_anterior():
+    from contornos_compatibles import priorizar_cilindros_respaldados
+    from meshfit_brep import _FrozenMesh,_region_surfaces
+    mesh,primitive=_cilindro_segmentado();frozen=_FrozenMesh(mesh)
+    approximate_plane={'type':'plane','point':np.zeros(3),'normal':np.array([0.,0.,1.]),'faces':primitive['faces']}
+    result={'primitives':[approximate_plane,primitive]}
+    regions=priorizar_cilindros_respaldados(result,frozen)
+    labels,surfaces=_region_surfaces(result,frozen,.006,.003,extra=regions)
+    assert all(isinstance(surfaces[int(labels[i])],Geom_CylindricalSurface) for i in primitive['faces'])
+
+def test_vertices_cilindricos_no_redondean_un_poligono_real():
+    from contornos_compatibles import priorizar_cilindros_respaldados
+    from meshfit_brep import _FrozenMesh
+    mesh,primitive=_cilindro_segmentado(sections=6)
+    assert priorizar_cilindros_respaldados({'primitives':[primitive]},_FrozenMesh(mesh))==[]
+
+def test_prioridad_cilindrica_respeta_entidades_usuario_y_stl_original():
+    from contornos_compatibles import priorizar_cilindros_respaldados
+    from meshfit_brep import _FrozenMesh,_region_surfaces
+    mesh,primitive=_cilindro_segmentado();vertices=mesh.vertices.copy();faces=mesh.faces.copy()
+    ids=np.array([primitive['faces'][0]]);surface=Geom_Plane(gp_Pln(gp_Pnt(),gp_Dir(1,0,0)))
+    existing=[(ids,surface)];frozen=_FrozenMesh(mesh);result={'primitives':[primitive]}
+    regions=priorizar_cilindros_respaldados(result,frozen,existing)
+    labels,surfaces=_region_surfaces(result,frozen,.006,.003,extra=regions)
+    assert surfaces[int(labels[ids[0]])] is surface
+    assert len(existing)==1 and np.array_equal(existing[0][0],ids)
+    assert np.array_equal(mesh.vertices,vertices) and np.array_equal(mesh.faces,faces)
