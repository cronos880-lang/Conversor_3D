+def priorizar_cilindros_respaldados(result,mesh,extra=None):
+    """Conservar una superficie curva confirmada antes de absorberla como banda plana."""
+    import meshfit_brep as base
+    regions=list(extra or []);added=0
+    for primitive in result['primitives']:
+        if primitive['type']!='cylinder':continue
+        ids=np.asarray(primitive['faces'],dtype=int)
+        if not len(ids):continue
+        surface=base._prim_surface(primitive)
+        points=np.vstack((mesh.vertices[np.unique(mesh.faces[ids])],mesh.triangles_center[ids]))
+        error=float(np.linalg.norm(base._Proj(surface).batch(points)-points,axis=1).max())
+        if error<=.008:regions.append((ids.copy(),surface));added+=1
+    print('[contornos] cilindros fuente con prioridad:',added,flush=True)
+    return regions
 
