+    wx = np.append(wc, wc[0] + P)
+    fy = np.append(prof, prof[0])
+    g = CubicSpline(wx, fy, bc_type="periodic")
+    return (lambda ww, _g=g, _P=P, _w0=wc[0]: _g(_w0 + np.mod(ww - _w0, _P))), wc, prof
