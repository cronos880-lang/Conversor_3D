+        ok = (T[:, 0] != T[:, 1]) & (T[:, 1] != T[:, 2]) & (T[:, 2] != T[:, 0])
+        rep["degenerados"] += int((~ok).sum())
+        n0 = int(ok.sum())
+        T = _cancel_pairs(T[ok])
+        rep["anulados"] += n0 - len(T)
