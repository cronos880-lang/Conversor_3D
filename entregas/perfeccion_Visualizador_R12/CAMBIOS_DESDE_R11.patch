+            pm = 0.5 * (p0 + p1)
+            Vm = TopoDS_Vertex()
+            B.MakeVertex(Vm, crv.Value(pm), 1e-6)
+            ends = [(V0, Vm, p0, pm), (Vm, V1, pm, p1)]
