+def propuestas(mesh,required,surfaces=(),tol=.008):
+ out=[]
+ for req in required:
+  a=req['eje'];q=req['centro'];radius=req['radio']
+  for s in surfaces:
+   if not isinstance(s,Geom_CylindricalSurface):continue
+   sa=np.array(s.Axis().Direction().Coord());sq=np.array(s.Location().Coord())
+   if abs(s.Radius()-radius)<=tol and abs(sa@a)>.99999 and np.linalg.norm(np.cross(sq-q,a))<=tol:
