+from OCP.TColgp import TColgp_Array2OfPnt
+from OCP.GeomAPI import GeomAPI_PointsToBSplineSurface
+from OCP.Approx import Approx_IsoParametric
+from OCP.GeomAbs import GeomAbs_C2
