+                plane2 = False
+            else:
+                dl /= np.linalg.norm(dl)
+                A3 = np.array([n1, n2, dl]); b3 = np.array([n1 @ o1, n2 @ o2, dl @ P.mean(0)])
+                p0l = np.linalg.solve(A3, b3)
