+def _components(adj, labels, nf):
+    same = labels[adj[:, 0]] == labels[adj[:, 1]]
+    a = adj[same & (labels[adj[:, 0]] >= 0)]
+    g = coo_matrix((np.ones(len(a)), (a[:, 0], a[:, 1])), shape=(nf, nf))
+    _, comp = connected_components(g, directed=False)
+    return comp
