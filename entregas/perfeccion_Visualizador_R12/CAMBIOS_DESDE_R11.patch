+    c2, R = _fit_circle_2d(uv)
+    t = pts @ axis
+    axis_pt = u * c2[0] + v * c2[1] + axis * t.mean()
+    return {"type": "cylinder", "axis": axis, "point": axis_pt, "radius": R,
+            "tmin": float(t.min()), "tmax": float(t.max()), "u": u, "v": v, "c2": c2}
