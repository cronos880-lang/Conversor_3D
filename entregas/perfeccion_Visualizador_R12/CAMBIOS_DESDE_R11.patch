+    # Nodos interiores Chebyshev y extremos en CADA tramo polinómico.
+    nodes=(1-np.cos(np.linspace(0,np.pi,degree+1)))*.5
+    values=[]
+    for a,b in zip(breaks[:-1],breaks[1:]):values.extend(a+(b-a)*nodes)
+    return np.unique(np.asarray(values))
