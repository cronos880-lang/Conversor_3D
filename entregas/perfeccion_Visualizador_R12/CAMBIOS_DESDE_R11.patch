+        # diferentes marcos UV sobre EL MISMO cilindro. No existe una línea
+        # de intersección única entre soportes coincidentes: conservar la
+        # frontera del STL sobre ese soporte, sin fusionar radios distintos.
+        a=np.array(sa.Axis().Direction().Coord());b=np.array(sb.Axis().Direction().Coord())
