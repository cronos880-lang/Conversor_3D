+    mu, mv = 0.08 * lu + 1e-3, 0.08 * lv + 1e-3
+    bb = [u.min() - mu, u.max() + mu, v.min() - mv, v.max() + mv]
+
+    gu, gv = np.meshgrid(np.linspace(bb[0], bb[1], 24), np.linspace(bb[2], bb[3], 24))
+    gu, gv = gu.ravel(), gv.ravel()
