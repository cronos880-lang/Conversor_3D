+            samples=np.array([curve.Value(float(t)).Coord() for t in np.linspace(first,last,65)])
+            if any(np.max(np.linalg.norm(_Proj(s).batch(samples)-samples,axis=1))>2e-8 for s in (sa,sb)):
+                raise ValueError('La costura no pertenece a ambos soportes cilíndricos')
+            if any(GeomAPI_ProjectPointOnCurve(_point(x),curve).LowerDistance()>max_move for x in points):
+                raise ValueError('La costura desplaza el contorno del STL')
