+def separar_planos_aproximados(mesh,labels,surfaces):
+    """Una tolerancia de región no convierte un redondeo en un plano exacto.
+
+    Mantener el núcleo coplanar y reconstruir aparte los triángulos del borde
+    absorbidos por el detector. No retirar triángulos ni alterar sus vértices.
+    """
+    import meshfit_brep as base
+    labels=labels.copy();surfaces=dict(surfaces);groups=base._groups(labels)
+    next_label=int(labels.max())+1;separated=0;measured=dict(getattr(mesh,"parches_altura_medidos",{}));joined=0
+    from restos_planos import componentes,plano_exacto,altura_medida
+    for l,ids in groups.items():
+        surface=surfaces[l]
+        if not isinstance(surface,Geom_Plane) or len(ids)<3:continue
+        vertices=np.asarray(mesh.vertices[mesh.faces[ids]])
+        # Hipótesis acotada del trabajador de barridos: la distancia a un
+        # plano es afín, por lo que TODOS los interiores de cada triángulo
+        # quedan certificados por sus tres vértices. El validador final no cambia.
+        if __import__('os').environ.get('VISOR_PLANOS_MEDIDOS')=='1':
+            plane=surface.Pln();n=np.array(plane.Axis().Direction().Coord());q=np.array(plane.Location().Coord())
+            if np.max(np.abs((vertices-q)@n))<=1e-4:continue
+        candidates=[surface]+[base._facet_surface(mesh,int(i)) for i in ids[np.argsort(-mesh.area_faces[ids])[:24]]]
+        best=None
+        for candidate in candidates:
+            if candidate is None:continue
+            plane=candidate.Pln();normal=np.array(plane.Axis().Direction().Coord());origin=np.array(plane.Location().Coord())
+            error=np.max(np.abs((vertices-origin)@normal),axis=1)
+            core=error<=1e-5;weight=float(mesh.area_faces[ids[core]].sum())
+            if best is None or weight>best[0]*(1+1e-4)+1e-12:best=(weight,candidate,core)
+        weight,candidate,core=best
+        if weight < .5*float(mesh.area_faces[ids].sum()):
+            fit=altura_medida(mesh,ids)
+            if fit is not None:
+                surfaces[l],measured[l]=fit
+                continue
+        if core.sum()<2:continue
+        surfaces[l]=candidate
+        other=ids[~core]
+        if not len(other):continue
+        for part in componentes(mesh,other):
+            exact=plano_exacto(mesh,part)
+            fit=None if exact is not None else altura_medida(mesh,part)
+            if exact is not None or fit is not None:
+                labels[part]=next_label;surfaces[next_label]=exact if exact is not None else fit[0]
+                if fit is not None:measured[next_label]=fit[1]
+                joined+=len(part)-1;next_label+=1
+            else:
+                for face in part:
+                    labels[face]=next_label;surfaces[next_label]=base._facet_surface(mesh,int(face));next_label+=1
+            separated+=len(part)
+    comp=base._split_connected(mesh,labels);result={}
+    proofs={}
+    for c in np.unique(comp):
+        index=int(np.flatnonzero(comp==c)[0]);old=int(labels[index]);result[int(c)]=surfaces[old]
+        if old in measured:proofs[int(c)]=measured[old]
+    mesh.parches_altura_medidos=proofs
+    print("[contornos] alturas medidas:",proofs,"facetas coplanares reunidas:",joined,flush=True)
+    print('[contornos] triángulos separados de planos aproximados:',separated,flush=True)
+    return comp,result
+
+def subdividir_parches_complejos(mesh,labels,surfaces,primary,triangulos_libres=None):
+    """Parches libres de más de cuatro lados: pares de triángulos conservados.
+
+    No pedir a una superficie aproximada que resuelva a la vez contornos
+    incompatibles o agujeros. Los recortes salen de la topología original.
+    """
+    import meshfit_brep as base
+    import os
+    single=(os.environ.get('VISOR_TRIANGULOS_LIBRES')=='1' if triangulos_libres is None else bool(triangulos_libres))
+    _,loops,_=base._boundary_chains(mesh,labels)
+    forced=getattr(mesh,"regiones_libres_refinadas",{})
+    targets=set()
+    for l,lps in loops.items():
+        if l in primary:continue
+        level=forced.get(id(surfaces[l]),0)
+        if level==1 and id(surfaces[l]) in getattr(mesh,'celdas_uv_agrupadas',set()):continue
+        if not level and (l in getattr(mesh,"parches_altura_medidos",{}) or id(surfaces[l]) in getattr(mesh,"hipotesis_parches_completos",set())):continue
+        maximum=1 if single or level>=2 else 2
