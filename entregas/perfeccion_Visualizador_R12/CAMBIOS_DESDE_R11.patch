+    print(f"  rejilla de control {data['grid']}")
+    print(f"  teselada: {len(data['vertices'])} vértices, {len(data['triangles'])} triángulos")
+    print(f"  RMS {data['rms']:.4f} mm · máx {data['max']:.4f} mm")
