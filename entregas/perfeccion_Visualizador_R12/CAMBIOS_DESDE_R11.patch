+def _unwrap(vals, period=2 * np.pi):
+
+    out = [float(vals[0])]
+    for x in vals[1:]:
+        prev = out[-1]
+        x = float(x)
+        while x - prev > period / 2:
+            x -= period
+        while x - prev < -period / 2:
+            x += period
+        out.append(x)
+    return out
