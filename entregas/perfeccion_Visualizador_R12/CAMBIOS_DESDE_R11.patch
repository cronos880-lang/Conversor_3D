+
+            ax = orig.Axis()
+            a = np.array([ax.Direction().X(), ax.Direction().Y(), ax.Direction().Z()])
+            q = np.array([ax.Location().X(), ax.Location().Y(), ax.Location().Z()])
+            d = cen - q
+            r = d - np.outer(d @ a, a)
+            ru = r / (np.linalg.norm(r, axis=1, keepdims=True) + 1e-12)
+            mdir = ru.mean(0)
+            if np.linalg.norm(mdir) < 0.2:
