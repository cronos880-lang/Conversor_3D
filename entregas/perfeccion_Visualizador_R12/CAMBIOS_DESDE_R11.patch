+            sub[fidx] = 0; sub[half] = 1
+            comp = _split_connected(mesh, np.where(sub >= 0, sub, -2 - np.arange(len(sub))))
+            is_bs = isinstance(orig, Geom_BSplineSurface)
+            for j, k in enumerate(np.unique(comp[fidx])):
+                part = fidx[comp[fidx] == k]
+                srf = orig
