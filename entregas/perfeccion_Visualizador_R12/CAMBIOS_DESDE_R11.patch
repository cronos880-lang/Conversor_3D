+def _frame(mesh, faces):
+
+    C = mesh.triangles_center[faces]
+    w = mesh.area_faces[faces]
+    c = (C * w[:, None]).sum(0) / w.sum()
+    M = ((C - c) * w[:, None]).T @ (C - c)
+    _, vec = np.linalg.eigh(M)
+    E = vec.T[::-1]
+    return np.vstack([E, -E])
