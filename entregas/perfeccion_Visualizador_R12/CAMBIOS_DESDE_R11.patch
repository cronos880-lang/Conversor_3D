+def _penalty3(nbu, nbv, su, sv, cyclic_u=False):
+
+    Du, Dv = _dmat(nbu, 3, cyclic_u), _dmat(nbv, 3)
+    P = sps.kron(Du.T @ Du, sps.identity(nbv)) / su ** 6
+    if Dv.shape[0]:
+        P = P + sps.kron(sps.identity(nbu), Dv.T @ Dv) / sv ** 6
+    return (P * (su * sv)).tocsr()
