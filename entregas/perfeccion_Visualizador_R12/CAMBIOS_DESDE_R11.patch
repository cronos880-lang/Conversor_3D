+            seglen = np.linalg.norm(np.diff(P, axis=0), axis=1)
+            ks = np.clip(np.ceil(seglen / step), 1, 16).astype(int)
+            Q0, owner, lims = [], [], []
+            for i, k in enumerate(ks):
