+                for _ in range(nit):
+                    for pr in pl:
+                        Q = pr.batch(Q)
+                bad = np.linalg.norm(Q - Q0, axis=1) > np.array(lims)
+                Q[bad] = Q0[bad]
+                owner = np.array(owner)
