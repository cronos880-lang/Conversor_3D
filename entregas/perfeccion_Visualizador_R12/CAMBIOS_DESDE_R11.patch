+                cyc = seq[:-1] if closed_loop else seq
+                n = len(cyc)
+
+                cuts = [i for i in range(n) if corner[cyc[i]] or nb[i - 1] != nb[i % len(nb)]]
+                if not closed_loop:
+                    cuts = sorted(set([0, n - 1] + cuts))
+                lp = []
+                if not cuts:
