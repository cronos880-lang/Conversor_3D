+    b = (uv ** 2).sum(axis=1)
+    sol, *_ = np.linalg.lstsq(A, b, rcond=None)
+    c = sol[:2]
+    R = np.sqrt(max(1e-12, sol[2] + c @ c))
+    return c, float(R)
