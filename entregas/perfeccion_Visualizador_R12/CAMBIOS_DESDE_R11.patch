+
+    lat = float(np.ptp((pts - c) @ x)) or 1.0
+    sv, sf = trimesh.remesh.subdivide_to_size(mesh.vertices, mesh.faces[faces], lat / 25.0)
+    S = np.unique(np.round(sv[np.unique(sf.ravel())], 9), axis=0)
