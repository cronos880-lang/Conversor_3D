+        from proyector_perfil import ProyectorPerfil
+        projector=ProyectorPerfil(soporte_medido) if isinstance(soporte_medido,__import__('OCP.Geom',fromlist=['Geom_SurfaceOfLinearExtrusion']).Geom_SurfaceOfLinearExtrusion) else None
