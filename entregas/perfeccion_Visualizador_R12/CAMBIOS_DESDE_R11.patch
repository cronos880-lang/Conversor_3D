+        "INFORME DEL CONVERSOR\n" + json.dumps(meta,ensure_ascii=False,indent=2) +
+        "\n\n--- REGISTRO DEL MOTOR ---\n" + motor_log[-120000:] +
+        "\n\n--- SALIDA Y ERRORES ---\n" + salida[-10000:] + "\n" + errores[-10000:],
+        encoding="utf-8",errors="replace")
