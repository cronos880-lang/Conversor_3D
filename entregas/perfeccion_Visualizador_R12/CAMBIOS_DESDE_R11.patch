+def _interpolar(points,closed=False):
+    array=TColgp_HArray1OfPnt(1,len(points))
+    for i,p in enumerate(points):array.SetValue(i+1,_point(p))
+    interp=GeomAPI_Interpolate(array,closed,1e-10);interp.Perform()
