+    if isinstance(curve,(Geom_BSplineCurve,Geom_BezierCurve)):
+        result=(curve.Copy() if isinstance(curve,Geom_BSplineCurve) else GeomConvert.CurveToBSplineCurve_s(curve).Copy())
