+        blocks.append(sps.hstack([sps.csr_matrix((n, o)), sps.diags(N[:, k]) @ B,
+                                  sps.csr_matrix((n, ntot - o - m["nb"]))]).tocsr())
+    R = (blocks[0] + blocks[1] + blocks[2]).tocsr()
+    return R, -(m["target"][rows] * N).sum(1)
