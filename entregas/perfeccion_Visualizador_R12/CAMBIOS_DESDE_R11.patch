+        for a0 in list(d.keys()):
+            for (b0, _) in d[a0]:
+                if (a0, b0) in used:
+                    continue
+
+                seq = [a0]; nb = []
+                a, b = a0, b0
+                while True:
+                    used.add((a, b))
+                    nb.append(next(l for (bb, l) in d[a] if bb == b))
+                    seq.append(b)
+                    if b == a0:
+                        break
+                    nxt = [bb for (bb, _) in d.get(b, []) if (b, bb) not in used]
+                    if not nxt:
+                        break
+                    a, b = b, nxt[0]
