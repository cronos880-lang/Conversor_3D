+            fan=incident[index];touch=set(fan)
+            if not any(a in touch or b in touch for a,b in pairs):continue
+            normal=np.average(n[fan],axis=0,weights=np.maximum(area[fan],1e-30))
+            norm=np.linalg.norm(normal)
