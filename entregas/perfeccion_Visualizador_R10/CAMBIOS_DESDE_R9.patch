+    if key in _RECHAZOS_TRABAJADOR:
+        raise ValueError('No se repite el mismo rescate rechazado con la misma entrada, perfil y parámetros: '+_RECHAZOS_TRABAJADOR[key])
+    shape=leer_solido_step_estricto(step)
